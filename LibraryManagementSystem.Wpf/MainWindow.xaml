<Window x:Class="LibraryManagementSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Library Management System"
        Height="720"
        Width="1120"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BeigeBackground}">
  <Grid x:Name="Root" Opacity="0">
    <Grid.Triggers>
      <EventTrigger RoutedEvent="Loaded">
        <BeginStoryboard>
          <Storyboard>
            <DoubleAnimation Storyboard.TargetName="Root"
                             Storyboard.TargetProperty="Opacity"
                             To="1"
                             Duration="0:0:0.4" />
          </Storyboard>
        </BeginStoryboard>
      </EventTrigger>
    </Grid.Triggers>

    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Margin="24,24,24,12"
            Background="{StaticResource CardBackground}"
            CornerRadius="18"
            Padding="20">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel>
          <TextBlock Text="Library Management System"
                     FontSize="22"
                     FontWeight="SemiBold" />
          <TextBlock Text="{Binding WelcomeMessage}"
                     FontSize="14"
                     Foreground="{StaticResource MutedText}"
                     Margin="0,6,0,0" />
        </StackPanel>

        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
          <TextBlock Text="{Binding DisplayName}"
                     FontSize="14"
                     HorizontalAlignment="Right" />
          <TextBlock Text="{Binding RoleLabel}"
                     FontSize="12"
                     Foreground="{StaticResource MutedText}"
                     HorizontalAlignment="Right"
                     Margin="0,2,0,0" />
          <Button Style="{StaticResource PrimaryButtonStyle}"
                  Content="Sign out"
                  Command="{Binding SignOutCommand}"
                  Margin="0,10,0,0" />
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1"
                  Margin="24,0,24,24"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding Cards}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Style="{StaticResource BentoCardButtonStyle}"
                    Width="{Binding Width}"
                    Height="{Binding Height}"
                    IsEnabled="{Binding IsEnabled}"
                    Command="{Binding Command}"
                    Margin="10">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Width="46"
                        Height="46"
                        CornerRadius="12"
                        Background="{Binding AccentBrush}">
                  <TextBlock Text="{Binding IconText}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             FontSize="14"
                             FontWeight="SemiBold" />
                </Border>

                <StackPanel Grid.Row="1" Margin="0,16,0,0">
                  <TextBlock Text="{Binding Title}"
                             FontSize="18"
                             FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Subtitle}"
                             Foreground="{StaticResource MutedText}"
                             TextWrapping="Wrap"
                             Margin="0,6,0,0" />
                </StackPanel>
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <TextBlock Grid.Row="2"
               Margin="28,0,28,20"
               Foreground="{StaticResource MutedText}"
               Text="Role-based access is active. Admins can manage users and settings; librarians manage daily operations." />
  </Grid>
</Window>
