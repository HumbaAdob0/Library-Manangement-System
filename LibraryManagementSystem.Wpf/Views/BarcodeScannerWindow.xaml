<Window x:Class="LibraryManagementSystem.Views.BarcodeScannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scan ISBN Barcode"
        Height="560"
        Width="760"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Background="Transparent"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Grid Margin="18">
        <Border Background="{StaticResource CardBackground}"
                CornerRadius="16"
                Padding="22">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.18" />
            </Border.Effect>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Scan ISBN Barcode"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryText}" />
            <TextBlock Text="Point the camera at the book barcode. The ISBN fills in automatically when detected."
                       FontSize="13"
                       Foreground="{StaticResource MutedText}"
                       Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1"
                Background="#1F1F1F"
                BorderBrush="{StaticResource SoftBorder}"
                BorderThickness="1"
                CornerRadius="12"
                ClipToBounds="True">
            <Grid>
                <Image x:Name="PreviewImage"
                       Stretch="Uniform"
                       SnapsToDevicePixels="True" />
                <Border Width="420"
                        Height="170"
                        BorderBrush="{StaticResource AccentSand}"
                        BorderThickness="2"
                        CornerRadius="10"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Opacity="0.85" />
            </Grid>
        </Border>

        <TextBlock x:Name="StatusTextBlock"
                   Grid.Row="2"
                   Text="Starting camera..."
                   FontSize="13"
                   Foreground="{StaticResource MutedText}"
                   TextWrapping="Wrap"
                   Margin="0,14,0,0" />

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button Content="Cancel"
                    Style="{StaticResource SecondaryButtonStyle}"
                    IsCancel="True"
                    Width="110"
                    Height="38"
                    Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
        </Border>
    </Grid>
</Window>
