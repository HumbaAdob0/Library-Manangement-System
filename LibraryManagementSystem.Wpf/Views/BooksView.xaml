<UserControl x:Class="LibraryManagementSystem.Views.BooksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="📚 Books Management"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Margin="0,0,0,16" />

        <!-- Search and Actions -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Style="{StaticResource BentoTextBoxStyle}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Height="36" />
                <TextBlock Grid.Column="0"
                           Text="Search by title, author, ISBN, or genre..."
                           FontSize="12"
                           Foreground="{StaticResource MutedText}"
                           IsHitTestVisible="False"
                           VerticalAlignment="Center"
                           Margin="14,0,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SearchText}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Button Grid.Column="1"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Content="Search"
                        Command="{Binding SearchCommand}"
                        Width="80"
                        Height="36"
                        Margin="8,0,0,0" />
            </Grid>

            <Button Grid.Column="1"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Content="➕ Add Book"
                    Command="{Binding AddBookCommand}"
                    Height="36"
                    Margin="8,0,0,0" />

            <Button Grid.Column="2"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Content="✏️ Edit"
                    Command="{Binding EditBookCommand}"
                    Height="36"
                    Margin="8,0,0,0" />

            <Button Grid.Column="3"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Content="🗑️ Delete"
                    Command="{Binding DeleteBookCommand}"
                    Height="36"
                    Margin="8,0,0,0" />
        </Grid>

        <!-- Books List -->
        <Border Grid.Row="2"
                Background="{StaticResource CardBackground}"
                BorderBrush="#E5D8C8"
                BorderThickness="1"
                CornerRadius="12">
            <DataGrid ItemsSource="{Binding Books}"
                      SelectedItem="{Binding SelectedBook}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      GridLinesVisibility="None"
                      HeadersVisibility="Column"
                      SelectionMode="Single"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      Background="Transparent"
                      BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="2*" />
                    <DataGridTextColumn Header="Author" Binding="{Binding Author}" Width="1.5*" />
                    <DataGridTextColumn Header="ISBN" Binding="{Binding ISBN}" Width="1*" />
                    <DataGridTextColumn Header="Genre" Binding="{Binding Genre}" Width="1*" />
                    <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="1.5*" />
                    <DataGridTextColumn Header="Year" Binding="{Binding PublishedYear}" Width="0.7*" />
                    <DataGridTextColumn Header="Total" Binding="{Binding TotalCopies}" Width="0.6*" />
                    <DataGridTextColumn Header="Available" Binding="{Binding AvailableCopies}" Width="0.8*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="3"
                Background="#F6F1E7"
                CornerRadius="8"
                Padding="12"
                Margin="0,16,0,0">
            <Grid>
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="12"
                           Foreground="{StaticResource MutedText}" />
                <TextBlock Text="Loading..."
                           FontSize="12"
                           Foreground="{StaticResource MutedText}"
                           HorizontalAlignment="Right"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>

        <!-- Add/Edit Dialog Overlay -->
        <Border Grid.Row="0" Grid.RowSpan="4"
                Background="#80000000"
                Visibility="{Binding IsAddEditDialogOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Background="{StaticResource CardBackground}"
                    CornerRadius="16"
                    Padding="32"
                    MaxWidth="600"
                    MaxHeight="700"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Dialog Header -->
                    <TextBlock Grid.Row="0"
                               Text="{Binding DialogTitleText}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Margin="0,0,0,24" />

                    <!-- Dialog Content -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="500">
                        <StackPanel>
                            <TextBlock Text="Title *" FontSize="12" Foreground="{StaticResource MutedText}" />
                            <TextBox Style="{StaticResource BentoTextBoxStyle}"
                                     Text="{Binding DialogTitle, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,6,0,16" />

                            <TextBlock Text="ISBN *" FontSize="12" Foreground="{StaticResource MutedText}" />
                            <TextBox Style="{StaticResource BentoTextBoxStyle}"
                                     Text="{Binding DialogISBN, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,6,0,16" />

                            <TextBlock Text="Author *" FontSize="12" Foreground="{StaticResource MutedText}" />
                            <TextBox Style="{StaticResource BentoTextBoxStyle}"
                                     Text="{Binding DialogAuthor, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,6,0,16" />

                            <TextBlock Text="Genre" FontSize="12" Foreground="{StaticResource MutedText}" />
                            <TextBox Style="{StaticResource BentoTextBoxStyle}"
                                     Text="{Binding DialogGenre, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,6,0,16" />

                            <TextBlock Text="Publisher" FontSize="12" Foreground="{StaticResource MutedText}" />
                            <TextBox Style="{StaticResource BentoTextBoxStyle}"
                                     Text="{Binding DialogPublisher, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,6,0,16" />

                            <TextBlock Text="Published Year" FontSize="12" Foreground="{StaticResource MutedText}" />
                            <TextBox Style="{StaticResource BentoTextBoxStyle}"
                                     Text="{Binding DialogPublishedYear, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,6,0,16" />

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Total Copies *" FontSize="12" Foreground="{StaticResource MutedText}" />
                                    <TextBox Style="{StaticResource BentoTextBoxStyle}"
                                             Text="{Binding DialogTotalCopies, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,6,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Available Copies *" FontSize="12" Foreground="{StaticResource MutedText}" />
                                    <TextBox Style="{StaticResource BentoTextBoxStyle}"
                                             Text="{Binding DialogAvailableCopies, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,6,0,0" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Description" FontSize="12" Foreground="{StaticResource MutedText}" />
                            <TextBox Style="{StaticResource BentoTextBoxStyle}"
                                     Text="{Binding DialogDescription, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     Height="80"
                                     Margin="0,6,0,0" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Dialog Actions -->
                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,16,0,0">
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Content="Cancel"
                                Command="{Binding CancelDialogCommand}"
                                Width="100"
                                Height="36"
                                Margin="0,0,8,0" />
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Content="Save"
                                Command="{Binding SaveBookCommand}"
                                Width="100"
                                Height="36" />
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
