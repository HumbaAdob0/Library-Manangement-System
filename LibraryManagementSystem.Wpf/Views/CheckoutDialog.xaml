<Window x:Class="LibraryManagementSystem.Views.CheckoutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Checkout Book"
        Height="260"
        Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Vertical" Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Select Patron:" FontSize="12" Foreground="{StaticResource MutedText}" />
            <ComboBox x:Name="PatronCombo"
                      DisplayMemberPath="FullName"
                      SelectedValuePath="Id"
                      Height="32"
                      Margin="0,6,0,0" />
        </StackPanel>

        <StackPanel Orientation="Vertical" Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="Select Book:" FontSize="12" Foreground="{StaticResource MutedText}" />
            <ComboBox x:Name="BookCombo"
                      DisplayMemberPath="Title"
                      SelectedValuePath="Id"
                      Height="32"
                      Margin="0,6,0,0" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Right">
            <Button Style="{StaticResource PrimaryButtonStyle}"
                    Content="Cancel"
                    Width="90"
                    Height="34"
                    Margin="0,0,8,0"
                    Click="Cancel_Click" />
            <Button Style="{StaticResource PrimaryButtonStyle}"
                    Content="Checkout"
                    Width="100"
                    Height="34"
                    Click="Ok_Click" />
        </StackPanel>
    </Grid>
</Window>
