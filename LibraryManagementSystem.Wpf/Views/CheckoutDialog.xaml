<UserControl x:Class="LibraryManagementSystem.Views.CheckoutDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="500">
    <Border Background="{StaticResource CardBackground}" Padding="16" CornerRadius="12">
        <StackPanel>
            <TextBlock Text="Checkout Book" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />

            <TextBlock Text="Patron" />
            <ComboBox ItemsSource="{Binding AvailablePatrons}" SelectedItem="{Binding SelectedPatronForCheckout}" DisplayMemberPath="FullName" Margin="0,6,0,12" />

            <TextBlock Text="Book" />
            <ComboBox ItemsSource="{Binding AvailableBooks}" SelectedItem="{Binding SelectedBookForCheckout}" DisplayMemberPath="Title" Margin="0,6,0,12" />

            <StackPanel Orientation="Horizontal" Margin="0,6,0,12">
                <StackPanel Width="200">
                    <TextBlock Text="Checkout Date" />
                    <DatePicker SelectedDate="{Binding CheckoutDate}" />
                </StackPanel>
                <StackPanel Width="200" Margin="16,0,0,0">
                    <TextBlock Text="Due Date" />
                    <DatePicker SelectedDate="{Binding DueDate}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Command="{Binding CancelCheckoutCommand}" Margin="0,0,8,0" />
                <Button Content="Checkout" Command="{Binding SaveCheckoutCommand}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
