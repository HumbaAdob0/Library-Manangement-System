<Window x:Class="LibraryManagementSystem.Views.CheckoutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Checkout Book"
        Height="400"
        Width="550"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None">
    <Border Background="{StaticResource CardBackground}" 
            CornerRadius="16"
            Padding="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.15" />
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" 
                    Background="{StaticResource AccentSand}"
                    CornerRadius="16,16,0,0"
                    Padding="24,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Border Background="{StaticResource AccentClay}"
                            Width="40" 
                            Height="40" 
                            CornerRadius="10"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0">
                        <TextBlock Text="📚" 
                                  FontSize="22"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                    </Border>
                    
                    <TextBlock Grid.Column="1"
                              Text="Checkout Book" 
                              FontSize="20" 
                              FontWeight="Bold"
                              Foreground="{StaticResource PrimaryText}"
                              VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Form Content -->
            <ScrollViewer Grid.Row="1" 
                         VerticalScrollBarVisibility="Auto"
                         Padding="24,20">
                <StackPanel>
                    <!-- Patron Selection -->
                    <TextBlock Text="Patron Selection" 
                              FontSize="15" 
                              FontWeight="SemiBold"
                              Foreground="{StaticResource PrimaryText}"
                              Margin="0,0,0,12"/>

                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Select Patron *" 
                                  FontWeight="SemiBold" 
                                  FontSize="13"
                                  Foreground="{StaticResource MutedText}"
                                  Margin="0,0,0,6"/>
                        <Border Background="{StaticResource BeigeBackground}"
                                BorderBrush="{StaticResource AccentSage}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="2">
                            <ComboBox x:Name="PatronCombo"
                                     DisplayMemberPath="FullName"
                                     SelectedValuePath="Id"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     FontSize="14"
                                     Padding="10,8"
                                     Height="40"/>
                        </Border>
                    </StackPanel>

                    <!-- Book Selection -->
                    <TextBlock Text="Book Selection" 
                              FontSize="15" 
                              FontWeight="SemiBold"
                              Foreground="{StaticResource PrimaryText}"
                              Margin="0,0,0,12"/>

                    <StackPanel>
                        <TextBlock Text="Select Book *" 
                                  FontWeight="SemiBold" 
                                  FontSize="13"
                                  Foreground="{StaticResource MutedText}"
                                  Margin="0,0,0,6"/>
                        <Border Background="{StaticResource BeigeBackground}"
                                BorderBrush="{StaticResource AccentSage}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="2">
                            <ComboBox x:Name="BookCombo"
                                     DisplayMemberPath="Title"
                                     SelectedValuePath="Id"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     FontSize="14"
                                     Padding="10,8"
                                     Height="40"/>
                        </Border>
                    </StackPanel>

                    <!-- Information Banner -->
                    <Border Background="#E0F2FE"
                            BorderBrush="#BAE6FD"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,10"
                            Margin="0,20,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ℹ️" 
                                      FontSize="14"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0"/>
                            <TextBlock Text="The book will be checked out with the default loan period" 
                                      FontSize="12"
                                      Foreground="#075985"
                                      VerticalAlignment="Center"
                                      TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer Actions -->
            <Border Grid.Row="2"
                    Background="{StaticResource BeigeBackground}"
                    BorderBrush="#E5D8C8"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,16,16"
                    Padding="24,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="1"
                            Content="Cancel" 
                            Click="Cancel_Click"
                            Background="Transparent"
                            Foreground="{StaticResource MutedText}"
                            BorderThickness="1"
                            BorderBrush="{StaticResource AccentSage}"
                            Height="40" 
                            Padding="24,0"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Margin="0,0,12,0"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="10"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentSage}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Grid.Column="2"
                            Click="Ok_Click"
                            Style="{StaticResource PrimaryButtonStyle}" 
                            Height="40" 
                            Padding="32,0"
                            FontSize="14"
                            FontWeight="SemiBold">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✓" 
                                      FontSize="16"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0"/>
                            <TextBlock Text="Checkout" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
