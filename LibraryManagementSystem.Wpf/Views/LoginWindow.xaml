<Window x:Class="LibraryManagementSystem.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:LibraryManagementSystem.Helpers"
        Title="Library Management System"
        Height="640"
        Width="980"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BeigeBackground}"
        Icon="/Assets/logo.png">
  <Grid x:Name="Root" Margin="24" Opacity="0">
    <Grid.Triggers>
      <EventTrigger RoutedEvent="Loaded">
        <BeginStoryboard>
          <Storyboard>
            <DoubleAnimation Storyboard.TargetName="Root"
                             Storyboard.TargetProperty="Opacity"
                             To="1"
                             Duration="0:0:0.4" />
          </Storyboard>
        </BeginStoryboard>
      </EventTrigger>
    </Grid.Triggers>

    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="1.2*" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0"
            CornerRadius="24"
            Padding="0"
            ClipToBounds="True">
      <Grid>
        <!-- Background Image -->
        <Image Source="/Assets/library_picture.jpg"
               Stretch="UniformToFill"
               Opacity="0.3" />
        
        <!-- Gradient Overlay -->
        <Border>
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#F6F1E7" Offset="0" />
              <GradientStop Color="#EAD9C7" Offset="1" />
            </LinearGradientBrush>
          </Border.Background>
          <Border.Opacity>0.9</Border.Opacity>
        </Border>

        <!-- Content -->
        <StackPanel Margin="32" VerticalAlignment="Center">
          <TextBlock Text="Welcome back"
                     FontSize="32"
                     FontWeight="SemiBold" />
          <TextBlock Text="Library Management System"
                     FontSize="18"
                     Foreground="{StaticResource MutedText}"
                     Margin="0,12,0,0" />
          <TextBlock Text="Secure access for admins and librarians"
                     FontSize="14"
                     Foreground="{StaticResource MutedText}"
                     Margin="0,8,0,0" />
          
          <Border Background="#FFFFFF"
                  CornerRadius="12"
                  Padding="16"
                  Margin="0,32,0,0"
                  Opacity="0.9">
            <StackPanel>
              <TextBlock Text="📚 Manage Books &amp; Inventory"
                         FontSize="13"
                         Margin="0,0,0,8" />
              <TextBlock Text="👥 Track Patrons &amp; Memberships"
                         FontSize="13"
                         Margin="0,0,0,8" />
              <TextBlock Text="🔄 Process Transactions &amp; Returns"
                         FontSize="13" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Column="1"
            Margin="24,0,0,0"
            Background="{StaticResource CardBackground}"
            CornerRadius="24"
            Padding="32">
      <StackPanel>
        <TextBlock Text="Sign in"
                   FontSize="20"
                   FontWeight="SemiBold" />
        <TextBlock Text="Use your staff credentials to continue"
                   Foreground="{StaticResource MutedText}"
                   Margin="0,8,0,24" />

        <TextBlock Text="Username" FontSize="12" Foreground="{StaticResource MutedText}" />
        <TextBox Style="{StaticResource BentoTextBoxStyle}"
                 Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,6,0,16" />

        <TextBlock Text="Password" FontSize="12" Foreground="{StaticResource MutedText}" />
        <Grid Margin="0,6,0,20">
          <PasswordBox x:Name="PasswordBox"
                       Style="{StaticResource BentoPasswordBoxStyle}"
                       helpers:PasswordBoxHelper.BindPassword="True"
                       helpers:PasswordBoxHelper.BoundPassword="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                       Visibility="{Binding IsPasswordVisible, Converter={StaticResource InverseBoolToVisibility}}" />
          
          <TextBox x:Name="PasswordTextBox"
                   Style="{StaticResource BentoTextBoxStyle}"
                   Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                   Visibility="{Binding IsPasswordVisible, Converter={StaticResource BoolToVisibility}}" />
          
          <Button Background="Transparent"
                  BorderThickness="0"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center"
                  Margin="0,0,8,0"
                  Padding="8"
                  Cursor="Hand"
                  Command="{Binding TogglePasswordVisibilityCommand}">
            <TextBlock FontSize="16">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Text" Value="👁️" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsPasswordVisible}" Value="True">
                      <Setter Property="Text" Value="🙈" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Button>
        </Grid>

        <Button Style="{StaticResource PrimaryButtonStyle}"
                Content="Sign in"
                Command="{Binding SignInCommand}"
                Height="42" />

        <TextBlock Text="{Binding ErrorMessage}"
                   Foreground="#B24836"
                   Margin="0,12,0,0"
                   TextWrapping="Wrap" />

        <TextBlock Text="Signing in..."
                   Foreground="{StaticResource MutedText}"
                   Margin="0,10,0,0"
                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <Border Background="#F6F1E7"
                CornerRadius="8"
                Padding="12"
                Margin="0,24,0,0">
          <StackPanel>
            <TextBlock Text="Default Credentials"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource MutedText}" />
            <TextBlock Text="Admin: admin / Admin@123"
                       FontSize="10"
                       Foreground="{StaticResource MutedText}"
                       Margin="0,4,0,0" />
            <TextBlock Text="Librarian: librarian / Librarian@123"
                       FontSize="10"
                       Foreground="{StaticResource MutedText}"
                       Margin="0,2,0,0" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>
  </Grid>
</Window>
