<UserControl x:Class="LibraryManagementSystem.Views.PatronDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LibraryManagementSystem.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="600">
    <Border Background="{StaticResource CardBackground}" Padding="16" CornerRadius="12">
        <StackPanel>
            <TextBlock Text="{Binding DialogTitle}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />

            <TextBlock Text="Full Name" />
            <TextBox Text="{Binding DialogFullName, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12" />

            <TextBlock Text="Membership ID" />
            <TextBox Text="{Binding DialogMembershipId, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12" />

            <TextBlock Text="Email" />
            <TextBox Text="{Binding DialogEmail, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12" />

            <TextBlock Text="Phone" />
            <TextBox Text="{Binding DialogPhone, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12" />

            <TextBlock Text="Membership Type" />
            <ComboBox SelectedItem="{Binding DialogMembershipType, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12">
                <ComboBoxItem Content="Standard" />
                <ComboBoxItem Content="Premium" />
            </ComboBox>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Command="{Binding CancelDialogCommand}" Margin="0,0,8,0" />
                <Button Content="Save" Command="{Binding SaveDialogCommand}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>