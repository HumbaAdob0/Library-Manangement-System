<UserControl x:Class="LibraryManagementSystem.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="📊 Overview"
                           FontSize="24"
                           FontWeight="SemiBold" />

                <Button Grid.Column="1"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Content="🔄 Refresh"
                        Command="{Binding RefreshCommand}"
                        Height="36"
                        Width="100" />
            </Grid>

            <!-- Overview Statistics Cards -->
            <Grid Grid.Row="1" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Books Card -->
                <Border Grid.Column="0" Grid.Row="0"
                        Background="{StaticResource CardBackground}"
                        BorderBrush="#E5D8C8"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16"
                        Margin="0,0,8,8">
                    <StackPanel>
                        <TextBlock Text="📚 Books" FontSize="14" Foreground="{StaticResource MutedText}" />
                        <TextBlock Text="{Binding TotalBooks}" FontSize="32" FontWeight="Bold" Margin="0,8,0,4" />
                        <TextBlock FontSize="11" Foreground="{StaticResource MutedText}">
                            <Run Text="{Binding AvailableBooks, Mode=OneWay}" />
                            <Run Text="available," />
                            <Run Text="{Binding CheckedOutBooks, Mode=OneWay}" />
                            <Run Text="checked out" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Patrons Card -->
                <Border Grid.Column="1" Grid.Row="0"
                        Background="{StaticResource CardBackground}"
                        BorderBrush="#E5D8C8"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16"
                        Margin="0,0,8,8">
                    <StackPanel>
                        <TextBlock Text="👥 Patrons" FontSize="14" Foreground="{StaticResource MutedText}" />
                        <TextBlock Text="{Binding TotalPatrons}" FontSize="32" FontWeight="Bold" Margin="0,8,0,4" />
                        <TextBlock FontSize="11" Foreground="{StaticResource MutedText}">
                            <Run Text="{Binding ActivePatrons, Mode=OneWay}" />
                            <Run Text="active members" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Transactions Card -->
                <Border Grid.Column="2" Grid.Row="0"
                        Background="{StaticResource CardBackground}"
                        BorderBrush="#E5D8C8"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16"
                        Margin="0,0,8,8">
                    <StackPanel>
                        <TextBlock Text="🔄 Transactions" FontSize="14" Foreground="{StaticResource MutedText}" />
                        <TextBlock Text="{Binding ActiveTransactions}" FontSize="32" FontWeight="Bold" Margin="0,8,0,4" />
                        <TextBlock FontSize="11" Foreground="{StaticResource MutedText}">
                            <Run Text="{Binding OverdueTransactions, Mode=OneWay}" />
                            <Run Text="overdue" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Fines Card -->
                <Border Grid.Column="3" Grid.Row="0"
                        Background="{StaticResource CardBackground}"
                        BorderBrush="#E5D8C8"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16"
                        Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="💰 Fines" FontSize="14" Foreground="{StaticResource MutedText}" />
                        <TextBlock Text="{Binding TotalFines, StringFormat='${0:N2}'}" FontSize="32" FontWeight="Bold" Margin="0,8,0,4" />
                        <TextBlock FontSize="11" Foreground="{StaticResource MutedText}">
                            <Run Text="{Binding UnpaidFines, StringFormat='${0:N2}', Mode=OneWay}" />
                            <Run Text="unpaid" />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Most Borrowed Books & Top Patrons -->
            <Grid Grid.Row="2" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Most Borrowed Books -->
                <Border Grid.Column="0"
                        Background="{StaticResource CardBackground}"
                        BorderBrush="#E5D8C8"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16"
                        Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="📖 Most Borrowed Books (Last 30 Days)"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,12" />
                        <DataGrid ItemsSource="{Binding MostBorrowedBooks}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  GridLinesVisibility="None"
                                  HeadersVisibility="Column"
                                  SelectionMode="Single"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  MaxHeight="300"
                                  RowHeight="40"
                                  ColumnHeaderHeight="40"
                                  AlternatingRowBackground="#F9F6F2"
                                  RowBackground="White">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="{StaticResource AccentSand}" />
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="FontSize" Value="13" />
                                    <Setter Property="Padding" Value="12,8" />
                                    <Setter Property="BorderThickness" Value="0,0,0,2" />
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentClay}" />
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Padding" Value="12,8" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridCell">
                                                <Border Background="{TemplateBinding Background}" 
                                                        BorderThickness="0"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AccentSage}" />
                                            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource BeigeBackground}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AccentSage}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="2*" />
                                <DataGridTextColumn Header="Author" Binding="{Binding Author}" Width="1.5*" />
                                <DataGridTextColumn Header="Borrows" Binding="{Binding BorrowCount}" Width="0.8*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- Top Patrons -->
                <Border Grid.Column="1"
                        Background="{StaticResource CardBackground}"
                        BorderBrush="#E5D8C8"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16"
                        Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="⭐ Top Patrons (Last 30 Days)"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,12" />
                        <DataGrid ItemsSource="{Binding TopPatrons}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  GridLinesVisibility="None"
                                  HeadersVisibility="Column"
                                  SelectionMode="Single"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  MaxHeight="300"
                                  RowHeight="40"
                                  ColumnHeaderHeight="40"
                                  AlternatingRowBackground="#F9F6F2"
                                  RowBackground="White">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="{StaticResource AccentSand}" />
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="FontSize" Value="13" />
                                    <Setter Property="Padding" Value="12,8" />
                                    <Setter Property="BorderThickness" Value="0,0,0,2" />
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentClay}" />
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Padding" Value="12,8" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridCell">
                                                <Border Background="{TemplateBinding Background}" 
                                                        BorderThickness="0"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AccentSage}" />
                                            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource BeigeBackground}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AccentSage}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                                <DataGridTextColumn Header="Books Borrowed" Binding="{Binding BorrowCount}" Width="1.5*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Overdue Books -->
            <Border Grid.Row="3"
                    Background="{StaticResource CardBackground}"
                    BorderBrush="#E5D8C8"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16"
                    Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="⚠️ Overdue Books"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,0,0,12" />
                    <DataGrid ItemsSource="{Binding OverdueBooks}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              GridLinesVisibility="None"
                              HeadersVisibility="Column"
                              SelectionMode="Single"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              Background="Transparent"
                              BorderThickness="0"
                              MaxHeight="250"
                              RowHeight="40"
                              ColumnHeaderHeight="40"
                              AlternatingRowBackground="#F9F6F2"
                              RowBackground="White">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{StaticResource AccentSand}" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="FontSize" Value="13" />
                                <Setter Property="Padding" Value="12,8" />
                                <Setter Property="BorderThickness" Value="0,0,0,2" />
                                <Setter Property="BorderBrush" Value="{StaticResource AccentClay}" />
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Padding" Value="12,8" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Background="{TemplateBinding Background}" 
                                                    BorderThickness="0"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentSage}" />
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource BeigeBackground}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentSage}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Book" Binding="{Binding Book.Title}" Width="2*" />
                            <DataGridTextColumn Header="Patron" Binding="{Binding Patron.FullName}" Width="1.5*" />
                            <DataGridTextColumn Header="Due Date" Binding="{Binding DueDate, StringFormat='{}{0:MM/dd/yyyy}'}" Width="1*" />
                            <DataGridTextColumn Header="Days Overdue" Width="1*">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="DueDate" Converter="{StaticResource DaysOverdueConverter}" />
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Status Bar -->
            <Border Grid.Row="4"
                    Background="#F6F1E7"
                    CornerRadius="8"
                    Padding="12">
                <Grid>
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="12"
                               Foreground="{StaticResource MutedText}" />
                    <TextBlock Text="Loading..."
                               FontSize="12"
                               Foreground="{StaticResource MutedText}"
                               HorizontalAlignment="Right"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
