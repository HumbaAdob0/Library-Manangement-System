<UserControl x:Class="LibraryManagementSystem.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <ScrollViewer>
        <StackPanel Margin="12">
            <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>

            <Border Background="{StaticResource CardBackground}" Padding="16" CornerRadius="12">
                <StackPanel>
                    <TextBlock Text="Library Name" FontWeight="SemiBold" />
                    <TextBox Text="{Binding LibraryName, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12" />

                    <TextBlock Text="Default Loan Period (days)" FontWeight="SemiBold" />
                    <TextBox Text="{Binding DefaultLoanPeriodDays, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12" />

                    <TextBlock Text="Fine Per Day" FontWeight="SemiBold" />
                    <TextBox Text="{Binding FinePerDay, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12" />

                    <Button Content="Save Settings" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}" Height="36" Width="140" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>