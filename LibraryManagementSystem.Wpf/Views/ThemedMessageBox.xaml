<Window x:Class="LibraryManagementSystem.Views.ThemedMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Message"
        SizeToContent="WidthAndHeight"
        MinWidth="420"
        MaxWidth="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Background="Transparent">
    <Border Background="{StaticResource CardBackground}"
            CornerRadius="16"
            Margin="18"
            Padding="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.18" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource AccentSand}"
                    CornerRadius="16,16,0,0"
                    Padding="22,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="IconBorder"
                            Width="36"
                            Height="36"
                            CornerRadius="9"
                            Background="{StaticResource AccentClay}"
                            Margin="0,0,12,0">
                        <TextBlock x:Name="IconTextBlock"
                                   Text="i"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryText}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <TextBlock x:Name="TitleTextBlock"
                               Grid.Column="1"
                               Text="Message"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryText}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <TextBlock x:Name="MessageTextBlock"
                       Grid.Row="1"
                       Text="Message"
                       FontSize="13"
                       Foreground="{StaticResource PrimaryText}"
                       TextWrapping="Wrap"
                       LineHeight="20"
                       MaxWidth="480"
                       Margin="24,22,24,20" />

            <Border Grid.Row="2"
                    Background="{StaticResource BeigeBackground}"
                    BorderBrush="{StaticResource SoftBorder}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,16,16"
                    Padding="20,14">
                <StackPanel x:Name="ButtonsPanel"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right" />
            </Border>
        </Grid>
    </Border>
</Window>
