<UserControl x:Class="LibraryManagementSystem.Views.TransactionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:LibraryManagementSystem.Views"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="&#x1F504; Transactions Management"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Margin="0,0,0,16" />

        <!-- Filters and Actions -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Filter"
                       FontSize="12"
                       Foreground="{StaticResource MutedText}"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0" />

            <ComboBox Grid.Column="1"
                      Style="{StaticResource BentoComboBoxStyle}"
                      ItemsSource="{Binding FilterOptions}"
                      SelectedItem="{Binding SelectedFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      Width="150"
                      Height="36" />

            <Button Grid.Column="3"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Content="Checkout"
                    Command="{Binding CheckoutCommand}"
                    Height="36"
                    Margin="8,0,0,0" />

            <Button Grid.Column="4"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Content="Edit"
                    Command="{Binding EditTransactionCommand}"
                    Height="36"
                    Margin="8,0,0,0" />

            <Button Grid.Column="5"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Content="Return"
                    Command="{Binding ReturnCommand}"
                    Height="36"
                    Margin="8,0,0,0" />
        </Grid>

        <!-- Transactions List -->
        <Border Grid.Row="2"
                Background="{StaticResource CardBackground}"
                BorderBrush="#E5D8C8"
                BorderThickness="1"
                CornerRadius="12"
                Padding="0">
            <DataGrid ItemsSource="{Binding Transactions}"
                      SelectedItem="{Binding SelectedTransaction, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      GridLinesVisibility="None"
                      HeadersVisibility="Column"
                      SelectionMode="Single"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      Background="Transparent"
                      BorderThickness="0"
                      RowHeight="48"
                      ColumnHeaderHeight="44">
                
                <!-- DataGrid Resources for Styling -->
                <DataGrid.Resources>
                    <!-- Column Header Style -->
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F6F1E7" />
                        <Setter Property="Foreground" Value="#6B5E55" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="FontSize" Value="13" />
                        <Setter Property="Padding" Value="16,12" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Setter Property="BorderBrush" Value="#E5D8C8" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                    </Style>

                    <!-- Row Style -->
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F9F6F2" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#EAD9C7" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter Property="Background" Value="#E2CDB9" />
                            </MultiTrigger>
                        </Style.Triggers>
                    </Style>

                    <!-- Cell Style -->
                    <Style TargetType="DataGridCell">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="16,0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <!-- Book Column -->
                    <DataGridTextColumn Header="Book" Binding="{Binding Book.Title, TargetNullValue='N/A'}" Width="2*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Medium" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                <Setter Property="ToolTip" Value="{Binding Book.Title}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Patron Column -->
                    <DataGridTextColumn Header="Patron" Binding="{Binding Patron.FullName, TargetNullValue='N/A'}" Width="1.5*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                <Setter Property="ToolTip" Value="{Binding Patron.FullName}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Checkout Date Column -->
                    <DataGridTextColumn Header="Checkout Date" Binding="{Binding CheckoutDate, StringFormat='{}{0:MM/dd/yyyy}'}" Width="1.1*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource MutedText}" />
                                <Setter Property="HorizontalAlignment" Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Due Date Column -->
                    <DataGridTextColumn Header="Due Date" Binding="{Binding DueDate, StringFormat='{}{0:MM/dd/yyyy}'}" Width="1.1*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
                                <Setter Property="FontWeight" Value="Medium" />
                                <Setter Property="HorizontalAlignment" Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Return Date Column -->
                    <DataGridTextColumn Header="Return Date" Binding="{Binding ReturnDate, StringFormat='{}{0:MM/dd/yyyy}', TargetNullValue='-'}" Width="1.1*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource MutedText}" />
                                <Setter Property="HorizontalAlignment" Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Fine Column -->
                    <DataGridTemplateColumn Header="Fine" Width="0.8*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock HorizontalAlignment="Center"
                                           FontWeight="Medium">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding FineAmount, StringFormat='${0:F2}'}" />
                                            <Setter Property="Foreground" Value="{StaticResource MutedText}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FineAmount}" Value="0">
                                                    <Setter Property="Foreground" Value="{StaticResource MutedText}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Returned Status Column -->
                    <DataGridTemplateColumn Header="Status" Width="1*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <!-- Status Indicator Dot -->
                                    <Ellipse Width="8" Height="8" 
                                             VerticalAlignment="Center"
                                             Margin="0,0,8,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#10B981" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsReturned}" Value="False">
                                                        <Setter Property="Fill" Value="#F59E0B" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    
                                    <!-- Status Text -->
                                    <TextBlock FontWeight="Medium"
                                               FontSize="12"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Returned" />
                                                <Setter Property="Foreground" Value="#10B981" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsReturned}" Value="False">
                                                        <Setter Property="Text" Value="Active" />
                                                        <Setter Property="Foreground" Value="#F59E0B" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="3"
                Background="#F6F1E7"
                CornerRadius="8"
                Padding="12"
                Margin="0,16,0,0">
            <Grid>
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="12"
                           Foreground="{StaticResource MutedText}" />
                <TextBlock Text="Loading..."
                           FontSize="12"
                           Foreground="{StaticResource MutedText}"
                           HorizontalAlignment="Right"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>

        <!-- Edit Transaction Dialog Overlay -->
        <Border Grid.Row="0" Grid.RowSpan="4"
                Background="{StaticResource OverlayScrim}"
                Visibility="{Binding IsEditDialogOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Background="{StaticResource CardBackground}"
                    CornerRadius="16"
                    Padding="32"
                    Margin="24"
                    MaxWidth="640"
                    MaxHeight="680"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.15" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Edit Transaction"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Margin="0,0,0,24" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="500">
                        <StackPanel>
                            <TextBlock Text="Book *" FontSize="12" Foreground="{StaticResource MutedText}" />
                            <ComboBox Style="{StaticResource BentoComboBoxStyle}"
                                      ItemsSource="{Binding AvailableBooks}"
                                      DisplayMemberPath="Title"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding DialogBookId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Margin="0,6,0,16" />

                            <TextBlock Text="Patron *" FontSize="12" Foreground="{StaticResource MutedText}" />
                            <ComboBox Style="{StaticResource BentoComboBoxStyle}"
                                      ItemsSource="{Binding AvailablePatrons}"
                                      DisplayMemberPath="FullName"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding DialogPatronId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Margin="0,6,0,16" />

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Checkout Date *" FontSize="12" Foreground="{StaticResource MutedText}" />
                                    <DatePicker SelectedDate="{Binding DialogCheckoutDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Margin="0,6,0,0"
                                                Height="38" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Due Date *" FontSize="12" Foreground="{StaticResource MutedText}" />
                                    <DatePicker SelectedDate="{Binding DialogDueDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Margin="0,6,0,0"
                                                Height="38" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Margin="0,0,0,16"
                                        Visibility="{Binding IsSelectedTransactionReturned, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Return Date *" FontSize="12" Foreground="{StaticResource MutedText}" />
                                <DatePicker SelectedDate="{Binding DialogReturnDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Margin="0,6,0,0"
                                            Height="38" />
                            </StackPanel>

                            <TextBlock Text="Fine" FontSize="12" Foreground="{StaticResource MutedText}" />
                            <TextBox Style="{StaticResource BentoTextBoxStyle}"
                                     Text="{Binding DialogFineAmount, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}"
                                     Margin="0,6,0,0" />
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,16,0,0">
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Content="Cancel"
                                Command="{Binding CancelEditDialogCommand}"
                                Width="100"
                                Height="36"
                                Margin="0,0,8,0" />
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Content="Save"
                                Command="{Binding SaveTransactionCommand}"
                                Width="100"
                                Height="36" />
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
