<UserControl x:Class="LibraryManagementSystem.Views.TransactionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:LibraryManagementSystem.Views"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="🔄 Transactions Management"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Margin="0,0,0,16" />

        <!-- Filters and Actions -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Content="All"
                    Command="{Binding ShowAllCommand}"
                    Width="80"
                    Height="36" />

            <Button Grid.Column="1"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Content="Active"
                    Command="{Binding ShowActiveCommand}"
                    Width="80"
                    Height="36"
                    Margin="8,0,0,0" />

            <Button Grid.Column="2"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Content="Overdue"
                    Command="{Binding ShowOverdueCommand}"
                    Width="80"
                    Height="36"
                    Margin="8,0,0,0" />

            <Button Grid.Column="4"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Content="📤 Checkout"
                    Command="{Binding CheckoutCommand}"
                    Height="36"
                    Margin="8,0,0,0" />

            <Button Grid.Column="5"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Content="📥 Return"
                    Command="{Binding ReturnCommand}"
                    Height="36"
                    Margin="8,0,0,0" />
        </Grid>

        <!-- Transactions List -->
        <Border Grid.Row="2"
                Background="{StaticResource CardBackground}"
                BorderBrush="#E5D8C8"
                BorderThickness="1"
                CornerRadius="12">
            <DataGrid ItemsSource="{Binding Transactions}"
                      SelectedItem="{Binding SelectedTransaction, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      GridLinesVisibility="None"
                      HeadersVisibility="Column"
                      SelectionMode="Single"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      Background="Transparent"
                      BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Book" Binding="{Binding Book.Title, TargetNullValue='N/A'}" Width="2*" />
                    <DataGridTextColumn Header="Patron" Binding="{Binding Patron.FullName, TargetNullValue='N/A'}" Width="1.5*" />
                    <DataGridTextColumn Header="Checkout Date" Binding="{Binding CheckoutDate, StringFormat='{}{0:MM/dd/yyyy}'}" Width="1*" />
                    <DataGridTextColumn Header="Due Date" Binding="{Binding DueDate, StringFormat='{}{0:MM/dd/yyyy}'}" Width="1*" />
                    <DataGridTextColumn Header="Return Date" Binding="{Binding ReturnDate, StringFormat='{}{0:MM/dd/yyyy}', TargetNullValue='-'}" Width="1*" />
                    <DataGridTextColumn Header="Fine" Binding="{Binding FineAmount, StringFormat='${0:F2}'}" Width="0.7*" />
                    <DataGridCheckBoxColumn Header="Returned" Binding="{Binding IsReturned}" Width="0.8*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="3"
                Background="#F6F1E7"
                CornerRadius="8"
                Padding="12"
                Margin="0,16,0,0">
            <Grid>
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="12"
                           Foreground="{StaticResource MutedText}" />
                <TextBlock Text="Loading..."
                           FontSize="12"
                           Foreground="{StaticResource MutedText}"
                           HorizontalAlignment="Right"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
