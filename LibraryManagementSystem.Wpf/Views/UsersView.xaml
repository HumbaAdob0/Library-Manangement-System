<UserControl x:Class="LibraryManagementSystem.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:LibraryManagementSystem.Models"
             xmlns:helpers="clr-namespace:LibraryManagementSystem.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="🔐 Users &amp; Roles Management"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Margin="0,0,0,16" />

        <!-- Search and Actions -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Style="{StaticResource BentoTextBoxStyle}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Height="36" />
                <TextBlock Grid.Column="0"
                           Text="Search by username..."
                           FontSize="12"
                           Foreground="{StaticResource MutedText}"
                           IsHitTestVisible="False"
                           VerticalAlignment="Center"
                           Margin="14,0,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SearchText}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Button Grid.Column="1"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Content="Search"
                        Command="{Binding SearchCommand}"
                        Width="80"
                        Height="36"
                        Margin="8,0,0,0" />
            </Grid>

            <Button Grid.Column="1"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Content="Add User"
                    Command="{Binding AddUserCommand}"
                    Height="36"
                    Margin="8,0,0,0" />

            <Button Grid.Column="2"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Content="Edit"
                    Command="{Binding EditUserCommand}"
                    Height="36"
                    Margin="8,0,0,0" />

            <Button Grid.Column="3"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Content="Delete"
                    Command="{Binding DeleteUserCommand}"
                    Height="36"
                    Margin="8,0,0,0" />
        </Grid>

        <!-- Users List -->
        <Border Grid.Row="2"
                Background="{StaticResource CardBackground}"
                BorderBrush="#E5D8C8"
                BorderThickness="1"
                CornerRadius="12"
                Padding="0">
            <DataGrid ItemsSource="{Binding Users}"
                      SelectedItem="{Binding SelectedUser}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      GridLinesVisibility="None"
                      HeadersVisibility="Column"
                      SelectionMode="Single"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      Background="Transparent"
                      BorderThickness="0"
                      RowHeight="48"
                      ColumnHeaderHeight="44">
                
                <!-- DataGrid Resources for Styling -->
                <DataGrid.Resources>
                    <!-- Column Header Style -->
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F6F1E7" />
                        <Setter Property="Foreground" Value="#6B5E55" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="FontSize" Value="13" />
                        <Setter Property="Padding" Value="16,12" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Setter Property="BorderBrush" Value="#E5D8C8" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                    </Style>

                    <!-- Row Style -->
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F9F6F2" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#EAD9C7" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter Property="Background" Value="#E2CDB9" />
                            </MultiTrigger>
                        </Style.Triggers>
                    </Style>

                    <!-- Cell Style -->
                    <Style TargetType="DataGridCell">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="16,0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <!-- Username Column -->
                    <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="2*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Medium" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Role Column -->
                    <DataGridTemplateColumn Header="Role" Width="1.2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="8" 
                                        Padding="10,5"
                                        HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#DBEAFE" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Role}" Value="Admin">
                                                    <Setter Property="Background" Value="#FEE2E2" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Role}" Value="Librarian">
                                                    <Setter Property="Background" Value="#E0E7FF" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Role Icon -->
                                        <TextBlock FontSize="12" 
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,6,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="👤" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Role}" Value="Admin">
                                                            <Setter Property="Text" Value="👑" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Role}" Value="Librarian">
                                                            <Setter Property="Text" Value="📚" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        
                                        <!-- Role Text -->
                                        <TextBlock Text="{Binding Role}" 
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#1E40AF" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Role}" Value="Admin">
                                                            <Setter Property="Foreground" Value="#DC2626" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Role}" Value="Librarian">
                                                            <Setter Property="Foreground" Value="#4338CA" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Active Status Column -->
                    <DataGridTemplateColumn Header="Status" Width="1*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <!-- Status Indicator Dot -->
                                    <Ellipse Width="8" Height="8" 
                                             VerticalAlignment="Center"
                                             Margin="0,0,8,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#10B981" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                        <Setter Property="Fill" Value="#9CA3AF" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    
                                    <!-- Status Text -->
                                    <TextBlock FontWeight="Medium"
                                               FontSize="12"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Active" />
                                                <Setter Property="Foreground" Value="#10B981" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                        <Setter Property="Text" Value="Inactive" />
                                                        <Setter Property="Foreground" Value="#9CA3AF" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Created Date Column -->
                    <DataGridTextColumn Header="Created" Binding="{Binding CreatedAt, StringFormat='{}{0:MM/dd/yyyy}'}" Width="1.1*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource MutedText}" />
                                <Setter Property="HorizontalAlignment" Value="Center" />
                                <Setter Property="FontSize" Value="12" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="3"
                Background="#F6F1E7"
                CornerRadius="8"
                Padding="12"
                Margin="0,16,0,0">
            <Grid>
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="12"
                           Foreground="{StaticResource MutedText}" />
                <TextBlock Text="Loading..."
                           FontSize="12"
                           Foreground="{StaticResource MutedText}"
                           HorizontalAlignment="Right"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>

        <!-- Add/Edit Dialog Overlay -->
        <Border Grid.Row="0" Grid.RowSpan="4"
                Background="{StaticResource OverlayScrim}"
                Visibility="{Binding IsAddEditDialogOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Background="{StaticResource CardBackground}"
                    CornerRadius="16"
                    Margin="24"
                    MaxWidth="550"
                    MaxHeight="600"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.15" />
                </Border.Effect>
                
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" 
                            Background="{StaticResource AccentSand}"
                            CornerRadius="16,16,0,0"
                            Padding="24,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Border Background="{StaticResource AccentClay}"
                                    Width="40" 
                                    Height="40" 
                                    CornerRadius="10"
                                    VerticalAlignment="Center"
                                    Margin="0,0,12,0">
                                <TextBlock Text="👤" 
                                          FontSize="22"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                            </Border>
                            
                            <TextBlock Grid.Column="1"
                                      Text="{Binding DialogTitle}" 
                                      FontSize="20" 
                                      FontWeight="Bold"
                                      Foreground="{StaticResource PrimaryText}"
                                      VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Form Content -->
                    <ScrollViewer Grid.Row="1" 
                                 VerticalScrollBarVisibility="Auto"
                                 Padding="24,20">
                        <StackPanel>
                            <!-- Account Information Section -->
                            <TextBlock Text="Account Information" 
                                      FontSize="15" 
                                      FontWeight="SemiBold"
                                      Foreground="{StaticResource PrimaryText}"
                                      Margin="0,0,0,12"/>

                            <!-- Username -->
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="Username *" 
                                          FontWeight="SemiBold" 
                                          FontSize="13"
                                          Foreground="{StaticResource MutedText}"
                                          Margin="0,0,0,6"/>
                                <Border Background="{StaticResource BeigeBackground}"
                                        BorderBrush="{StaticResource AccentSage}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12,10">
                                    <TextBox Text="{Binding DialogUsername, UpdateSourceTrigger=PropertyChanged}" 
                                            BorderThickness="0"
                                            Background="Transparent"
                                            FontSize="14"/>
                                </Border>
                            </StackPanel>

                            <!-- Password -->
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="Password *" 
                                          FontWeight="SemiBold" 
                                          FontSize="13"
                                          Foreground="{StaticResource MutedText}"
                                          Margin="0,0,0,2"/>
                                <TextBlock Text="(Leave empty to keep current password)"
                                          FontSize="11"
                                          Foreground="{StaticResource MutedText}"
                                          Margin="0,0,0,6"
                                          Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibility}}" />
                                <Border Background="{StaticResource BeigeBackground}"
                                        BorderBrush="{StaticResource AccentSage}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="🔒" 
                                                  FontSize="14"
                                                  Foreground="{StaticResource MutedText}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,8,0"/>
                                        <PasswordBox Grid.Column="1"
                                                    x:Name="DialogPasswordBox"
                                                    BorderThickness="0"
                                                    Background="Transparent"
                                                    FontSize="14"
                                                    helpers:PasswordBoxHelper.BindPassword="True"
                                                    helpers:PasswordBoxHelper.BoundPassword="{Binding DialogPassword, Mode=TwoWay}" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Role & Status Section -->
                            <TextBlock Text="Role &amp; Status" 
                                      FontSize="15" 
                                      FontWeight="SemiBold"
                                      Foreground="{StaticResource PrimaryText}"
                                      Margin="0,4,0,12"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Role -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="User Role *" 
                                              FontWeight="SemiBold" 
                                              FontSize="13"
                                              Foreground="{StaticResource MutedText}"
                                              Margin="0,0,0,6"/>
                                    <Border Background="{StaticResource BeigeBackground}"
                                            BorderBrush="{StaticResource AccentSage}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="2">
                                        <ComboBox SelectedItem="{Binding DialogRole}"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 FontSize="14"
                                                 Padding="10,8"
                                                 Height="40">
                                            <ComboBox.ItemsSource>
                                                <x:Array Type="models:UserRole">
                                                    <models:UserRole>Admin</models:UserRole>
                                                    <models:UserRole>Librarian</models:UserRole>
                                                </x:Array>
                                            </ComboBox.ItemsSource>
                                        </ComboBox>
                                    </Border>
                                </StackPanel>

                                <!-- Active Status -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                    <Border Background="{StaticResource BeigeBackground}"
                                            BorderBrush="{StaticResource AccentSage}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="12,10"
                                            Height="40">
                                        <CheckBox Content="Active Account"
                                                 IsChecked="{Binding DialogIsActive}"
                                                 VerticalAlignment="Center"
                                                 FontSize="13"
                                                 FontWeight="Medium"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- Required Fields Note -->
                            <Border Background="#FEF3C7"
                                    BorderBrush="#FDE68A"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12,10"
                                    Margin="0,20,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="ℹ️" 
                                              FontSize="14"
                                              VerticalAlignment="Center"
                                              Margin="0,0,8,0"/>
                                    <TextBlock Text="Fields marked with * are required" 
                                              FontSize="12"
                                              Foreground="#92400E"
                                              VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer Actions -->
                    <Border Grid.Row="2"
                            Background="{StaticResource BeigeBackground}"
                            BorderBrush="#E5D8C8"
                            BorderThickness="0,1,0,0"
                            CornerRadius="0,0,16,16"
                            Padding="24,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="1"
                                    Content="Cancel" 
                                    Command="{Binding CancelDialogCommand}"
                                    Background="Transparent"
                                    Foreground="{StaticResource MutedText}"
                                    BorderThickness="1"
                                    BorderBrush="{StaticResource AccentSage}"
                                    Height="40" 
                                    Padding="24,0"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Margin="0,0,12,0"
                                    Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="10"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{StaticResource AccentSage}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button Grid.Column="2"
                                    Command="{Binding SaveUserCommand}" 
                                    Style="{StaticResource PrimaryButtonStyle}" 
                                    Height="40" 
                                    Padding="32,0"
                                    FontSize="14"
                                    FontWeight="SemiBold">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💾" 
                                              FontSize="16"
                                              VerticalAlignment="Center"
                                              Margin="0,0,8,0"/>
                                    <TextBlock Text="Save User" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
