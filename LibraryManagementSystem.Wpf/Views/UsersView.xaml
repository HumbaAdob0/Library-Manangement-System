<UserControl x:Class="LibraryManagementSystem.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:LibraryManagementSystem.Models"
             xmlns:helpers="clr-namespace:LibraryManagementSystem.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="🔐 Users &amp; Roles Management"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Margin="0,0,0,16" />

        <!-- Search and Actions -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Style="{StaticResource BentoTextBoxStyle}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Height="36" />
                <TextBlock Grid.Column="0"
                           Text="Search by username..."
                           FontSize="12"
                           Foreground="{StaticResource MutedText}"
                           IsHitTestVisible="False"
                           VerticalAlignment="Center"
                           Margin="14,0,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SearchText}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Button Grid.Column="1"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Content="Search"
                        Command="{Binding SearchCommand}"
                        Width="80"
                        Height="36"
                        Margin="8,0,0,0" />
            </Grid>

            <Button Grid.Column="1"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Content="➕ Add User"
                    Command="{Binding AddUserCommand}"
                    Height="36"
                    Margin="8,0,0,0" />

            <Button Grid.Column="2"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Content="✏️ Edit"
                    Command="{Binding EditUserCommand}"
                    Height="36"
                    Margin="8,0,0,0" />

            <Button Grid.Column="3"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Content="🗑️ Delete"
                    Command="{Binding DeleteUserCommand}"
                    Height="36"
                    Margin="8,0,0,0" />
        </Grid>

        <!-- Users List -->
        <Border Grid.Row="2"
                Background="{StaticResource CardBackground}"
                BorderBrush="#E5D8C8"
                BorderThickness="1"
                CornerRadius="12">
            <DataGrid ItemsSource="{Binding Users}"
                      SelectedItem="{Binding SelectedUser}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      GridLinesVisibility="None"
                      HeadersVisibility="Column"
                      SelectionMode="Single"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      Background="Transparent"
                      BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="2*" />
                    <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="1*" />
                    <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="0.8*" />
                    <DataGridTextColumn Header="Created" Binding="{Binding CreatedAt, StringFormat='{}{0:MM/dd/yyyy}'}" Width="1*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="3"
                Background="#F6F1E7"
                CornerRadius="8"
                Padding="12"
                Margin="0,16,0,0">
            <Grid>
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="12"
                           Foreground="{StaticResource MutedText}" />
                <TextBlock Text="Loading..."
                           FontSize="12"
                           Foreground="{StaticResource MutedText}"
                           HorizontalAlignment="Right"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>

        <!-- Add/Edit Dialog Overlay -->
        <Border Grid.Row="0" Grid.RowSpan="4"
                Background="#80000000"
                Visibility="{Binding IsAddEditDialogOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Background="{StaticResource CardBackground}"
                    CornerRadius="16"
                    Padding="32"
                    MaxWidth="500"
                    MaxHeight="500"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Dialog Header -->
                    <TextBlock Grid.Row="0"
                               Text="{Binding DialogTitle}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Margin="0,0,0,24" />

                    <!-- Dialog Content -->
                    <StackPanel Grid.Row="1">
                        <TextBlock Text="Username" FontSize="12" Foreground="{StaticResource MutedText}" />
                        <TextBox Style="{StaticResource BentoTextBoxStyle}"
                                 Text="{Binding DialogUsername, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,6,0,16" />

                        <TextBlock Text="Password" FontSize="12" Foreground="{StaticResource MutedText}" />
                        <TextBlock Text="(Leave empty to keep current password)"
                                   FontSize="10"
                                   Foreground="{StaticResource MutedText}"
                                   Margin="0,2,0,4"
                                   Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibility}}" />
                        <PasswordBox Style="{StaticResource BentoPasswordBoxStyle}"
                                     x:Name="DialogPasswordBox"
                                     Margin="0,6,0,16"
                                     helpers:PasswordBoxHelper.BindPassword="True"
                                     helpers:PasswordBoxHelper.BoundPassword="{Binding DialogPassword, Mode=TwoWay}" />

                        <TextBlock Text="Role" FontSize="12" Foreground="{StaticResource MutedText}" />
                        <ComboBox SelectedItem="{Binding DialogRole}"
                                  Margin="0,6,0,16"
                                  Height="36"
                                  Padding="12,8">
                            <ComboBox.ItemsSource>
                                <x:Array Type="models:UserRole">
                                    <models:UserRole>Admin</models:UserRole>
                                    <models:UserRole>Librarian</models:UserRole>
                                </x:Array>
                            </ComboBox.ItemsSource>
                        </ComboBox>

                        <CheckBox Content="Active"
                                  IsChecked="{Binding DialogIsActive}"
                                  Margin="0,0,0,16" />
                    </StackPanel>

                    <!-- Dialog Actions -->
                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,16,0,0">
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Content="Cancel"
                                Command="{Binding CancelDialogCommand}"
                                Width="100"
                                Height="36"
                                Margin="0,0,8,0" />
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Content="Save"
                                Command="{Binding SaveUserCommand}"
                                Width="100"
                                Height="36" />
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
