<Window x:Class="LibraryManagementSystem.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Library Management System" 
        Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{DynamicResource MaterialDesignPaper}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Bar -->
        <materialDesign:ColorZone Mode="PrimaryMid" Padding="16" Grid.Row="0">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <materialDesign:PackIcon Kind="Library" Width="32" Height="32" VerticalAlignment="Center"/>
                    <TextBlock Text="Library Management System" 
                              Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                              VerticalAlignment="Center"
                              Margin="16,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <materialDesign:PackIcon Kind="Account" Width="24" Height="24" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CurrentUserName}" 
                              VerticalAlignment="Center"
                              Margin="8,0,16,0"/>
                    <TextBlock Text="{Binding CurrentUserRole, StringFormat='({0})'}" 
                              VerticalAlignment="Center"
                              Margin="0,0,16,0"/>
                    <Button Content="Logout" 
                           Style="{StaticResource MaterialDesignFlatButton}"
                           Click="LogoutButton_Click"/>
                </StackPanel>
            </DockPanel>
        </materialDesign:ColorZone>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Navigation Menu -->
            <materialDesign:ColorZone Mode="Standard" Grid.Column="0" Padding="0">
                <ListBox x:Name="NavigationListBox" SelectionChanged="NavigationListBox_SelectionChanged">
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal" Margin="16,8">
                            <materialDesign:PackIcon Kind="ViewDashboard" Width="24" Height="24" VerticalAlignment="Center"/>
                            <TextBlock Text="Dashboard" VerticalAlignment="Center" Margin="16,0,0,0"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal" Margin="16,8">
                            <materialDesign:PackIcon Kind="Book" Width="24" Height="24" VerticalAlignment="Center"/>
                            <TextBlock Text="Books" VerticalAlignment="Center" Margin="16,0,0,0"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal" Margin="16,8">
                            <materialDesign:PackIcon Kind="AccountGroup" Width="24" Height="24" VerticalAlignment="Center"/>
                            <TextBlock Text="Patrons" VerticalAlignment="Center" Margin="16,0,0,0"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal" Margin="16,8">
                            <materialDesign:PackIcon Kind="SwapHorizontal" Width="24" Height="24" VerticalAlignment="Center"/>
                            <TextBlock Text="Transactions" VerticalAlignment="Center" Margin="16,0,0,0"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal" Margin="16,8">
                            <materialDesign:PackIcon Kind="ChartBar" Width="24" Height="24" VerticalAlignment="Center"/>
                            <TextBlock Text="Reports" VerticalAlignment="Center" Margin="16,0,0,0"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </materialDesign:ColorZone>

            <!-- Content Area -->
            <Border Grid.Column="1" Background="{DynamicResource MaterialDesignBackground}" Padding="16">
                <Frame x:Name="ContentFrame" NavigationUIVisibility="Hidden"/>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <materialDesign:ColorZone Mode="PrimaryLight" Padding="8" Grid.Row="2">
            <DockPanel>
                <TextBlock Text="Ready" DockPanel.Dock="Left"/>
                <TextBlock Text="{Binding Source={x:Static sys:DateTime.Now}, StringFormat='dd/MM/yyyy HH:mm'}" 
                          DockPanel.Dock="Right"
                          xmlns:sys="clr-namespace:System;assembly=mscorlib"/>
            </DockPanel>
        </materialDesign:ColorZone>
    </Grid>
</Window>
